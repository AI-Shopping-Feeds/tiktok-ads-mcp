# Copy to .env (gitignored) or ~/.tiktok-ads-mcp/.env and fill in. Never commit real values.

# --- Developer app (TikTok API for Business portal -> My Apps -> your app -> Basic Information) ---
# Needed for `tiktok-ads-mcp auth`, tiktok_ads_list_advertisers and `purge --revoke`.
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=

# --- Access token (set ONE of these, or neither if you use the default file) ---
# `tiktok-ads-mcp auth` saves it to ~/.tiktok-ads-mcp/secrets/tiktok-ads-token.json (owner-only).
TIKTOK_ADS_TOKEN_FILE=
# Or the long-term access token itself. Prefer the file.
TIKTOK_ADS_ACCESS_TOKEN=

# --- Optional ---

# Default ad account (tiktok_ads_list_advertisers shows them). Tools also take advertiser_id.
TIKTOK_ADS_ADVERTISER_ID=
# Default Business Center, for catalog tools.
TIKTOK_ADS_BC_ID=
# Only touch these ad accounts (comma-separated). Empty = every account the token can reach.
TIKTOK_ADS_ALLOWED_ADVERTISER_IDS=

# Start in dry-run: writes are logged and previewed but NOT sent to TikTok.
TIKTOK_ADS_DRY_RUN=true

# Register only read-only tools (lists, lookups, reports).
TIKTOK_ADS_READ_ONLY=false

# Only register some tool groups, e.g. accounts,campaigns,smart_plus,reporting
TIKTOK_ADS_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
TIKTOK_ADS_BULK_THRESHOLD=10
TIKTOK_ADS_MAX_INCREASE_PCT=20
# Optional absolute caps in the account currency (blank = no cap).
TIKTOK_ADS_MAX_BUDGET=
TIKTOK_ADS_MAX_BID=

# Audit log of writes (default ~/.tiktok-ads-mcp/logs/audit.jsonl) and days to keep entries (0 = forever).
TIKTOK_ADS_AUDIT_LOG=
TIKTOK_ADS_AUDIT_RETENTION_DAYS=30

# Requests per second (TikTok's Basic level allows 10), page size, timeout, largest report download.
TIKTOK_ADS_MAX_QPS=10
TIKTOK_ADS_PAGE_SIZE=100
TIKTOK_ADS_TIMEOUT=30
TIKTOK_ADS_MAX_DOWNLOAD_MB=200

TIKTOK_ADS_LOG_LEVEL=INFO

# Transport: stdio (most clients) or streamable-http (served at /mcp, no sign-in: keep it on localhost).
TIKTOK_ADS_TRANSPORT=stdio
TIKTOK_ADS_HOST=127.0.0.1
TIKTOK_ADS_PORT=8000
TIKTOK_ADS_ALLOW_REMOTE=false
